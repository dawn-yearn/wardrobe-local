# Local copy: select dashscope or openai. Keep all keys server-side; never prefix them with VITE_.
WARDROBE_VISION_PROVIDER=dashscope
WARDROBE_IMAGE_PROVIDER=dashscope

# Alibaba Cloud Model Studio / DashScope.
DASHSCOPE_API_KEY=
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_VISION_MODEL=qwen3.6-flash
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_OUTFIT_MODEL=qwen-image-2.0

# Optional OpenAI configuration. Used only when the corresponding provider is openai.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_OUTFIT_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Local paths, relative to this project directory.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
WARDROBE_DATA_DIR=data
